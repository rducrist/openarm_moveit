<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_policy</name>
  <version>0.1.0</version>
  <description>Step-wise deployment of Real2Render2Real (tinydp) diffusion policies on OpenArm through ee_pose_server. torch and tinydp come from the pixi `policy` environment.</description>
  <maintainer email="l.pinon@embodiedai.ch">Hackathon team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>openarm_ee_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
